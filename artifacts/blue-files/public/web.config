<?xml version="1.0" encoding="UTF-8"?>
<!--
  Blue Files at http://idn-production.lamipak.biz/apps/blue-files/
  IIS application mounted at /apps/blue-files, physical path = artifacts\blue-files\dist\public
  (static client served by IIS; this file is copied there by every `vite build`).
  /api/* is reverse-proxied to the pm2 app "blue-files" on :20072.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- mandatory for a nested mount: the gateway's web.config at /apps is inherited -->
        <clear />

        <rule name="canonical-trailing-slash" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{URL}" pattern="/$" negate="true" />
          </conditions>
          <action type="Redirect" url="/apps/blue-files/" appendQueryString="true" redirectType="Found" />
        </rule>

        <rule name="blue-files-api-proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:20072/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
